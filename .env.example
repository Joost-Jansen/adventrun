# Copy to .env for local development (never commit .env). On Railway set these as service variables.
ENV=development
DATABASE_URL=sqlite:///./adventrun.db
SECRET_KEY=
ADMIN_PASSWORD=
OWNER_NAME=Joost
# Round photo on the page (path or URL); leave empty for none
OWNER_PHOTO=/static/img/owner.webp
# The charity's fundraising page (https), used until one is set in the admin
ACTION_PAGE_URL=
CHARITY_NAME=het Rode Kruis
# Production: ENV=production, TRUST_PROXY=1, PUBLIC_ORIGINS=https://<your-domain>
PUBLIC_ORIGINS=
TRUST_PROXY=0
CHALLENGE_START=2026-12-01
CHALLENGE_DAYS=25
CHARITY_NAME_EN=the Red Cross
GOAL_PER_KM=3,25
